{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd backend && DATABASE_URL='postgres://postgres:postgres@localhost:55433/taskmanager?sslmode=disable' JWT_SECRET=dev-secret-for-local-check go run ./cmd/api"],
